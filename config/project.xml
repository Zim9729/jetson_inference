<root>
	<!-- 工程名称-->
	<!-- 北2：bei2 -->
	<!-- 广3：guang3 -->
    <project name="guang3"/> 
	
	



<pthreading>								<!-- 多线程参数 pthreading.exe -->
	<exename exename="proj2.exe"/>
	<imgtype json0_jpg1="1"/>  				<!-- 数据类型：0:读取json文件；1:读取jpg -->
	<thread_type thread_type="1"/>  		<!-- 进程类型：0:每个path对应一个进程(最多4个)；1:所有path的图片平均分成threadNum个进程 -->
	<thread_num thread_num="1"/>  			<!-- thread_type=1时进程个数 -->
	<path path="E:\0_project\proj2_20260411\data"/>
	<auto_detect enable="1" poll_interval_ms="5000"/>
</pthreading>
</root>




