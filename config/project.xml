<root>
	<!-- 工程名称-->
	<!-- 北2：bei2 -->
	<!-- 广3：guang3 -->
    <project name="guang3"/> 
	
	



<pthreading>								<!-- 多线程参数 pthreading.exe -->
	<exename exename="proj2.exe"/>
	<imgtype json0_jpg1="1"/>  				<!-- 数据类型：0:读取json文件；1:读取jpg -->
	<thread_type thread_type="1"/>  		<!-- 线程模式：0:保持按path顺序处理；1:单个目录内文件级并发，最终输出仍按原始顺序回收 -->
	<thread_num thread_num="1"/>  			<!-- thread_type=1时的worker数量，<=0时回退为1 -->
	<path path="E:\0_project\proj2_20260411\data\bench_manual\E1"/>
	<auto_detect enable="0" poll_interval_ms="5000" run_date="20260425"/> <!-- run_date格式：YYYYMMDD；留空则默认跑今天 -->
	<perf_profile enable="1" detail="stage" output_dir="perf"/>
</pthreading>
</root>




